<Window x:Class="CyberBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberShield"
        Height="700"
        Width="1000"
        Background="#1F0F18"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
        Background="#2A141F"
        CornerRadius="20"
        Padding="15"
        Height="180"
        Margin="0,0,0,10" HorizontalAlignment="Left" Width="970">

            <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- TITLE -->

                <TextBlock Text="CYBERSECURITY AWARENESS CHATBOT"
                   Foreground="#FF4FA3"
                   FontSize="34"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>
                <Image Source="/Image/logo.png"
               Width="413"
               Height="118"
               Stretch="Uniform" RenderTransformOrigin="1.827,0.763">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="0.398"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <!-- LOGO -->

            </StackPanel>

        </Border>



        <!-- CHAT AREA -->

        <Border Grid.Row="1"
                Background="#2A141F"
                CornerRadius="15"
                Padding="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <RichTextBox x:Name="txtChat"
             Background="#2A141F"
             Foreground="White"
             BorderThickness="0"
             FontSize="16"
             IsReadOnly="True"
             VerticalScrollBarVisibility="Auto"
             AcceptsReturn="True"/>

            </ScrollViewer>

        </Border>

        <!-- INPUT AREA -->

        <Grid Grid.Row="2"
              Margin="0,15,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtUserInput"
                     Height="45"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     Background="#351A28"
                     Foreground="White"
                     BorderBrush="#FF4FA3"
                     BorderThickness="2"
                     Padding="10"
                     KeyDown="txtUserInput_KeyDown"
/>

            <Button Grid.Column="1"
                    x:Name="btnSend"
                    Content="SEND"
                    Height="45"
                    Margin="10,0,0,0"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#FF4FA3"
                    Foreground="White"
                    Cursor="Hand"
                    BorderThickness="2"
                    Click="BtnSend_Click" VerticalAlignment="Top"/>



        </Grid>

    </Grid>
</Window>
